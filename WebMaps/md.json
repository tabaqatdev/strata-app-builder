      { "id": "md-schools", "title": "Education Facilities", "format": "arcgis-feature", "url": "https://mdgeodata.md.gov/imap/rest/services/Education/MD_EducationFacilities/FeatureServer/0", "geometry": "point", "category": "infrastructure", "coreRenderable": true, "solutions": ["emergency-response", "showcase"] },
      { "id": "md-acs", "title": "American Community Survey (MD)", "format": "arcgis-feature", "url": "https://mdgeodata.md.gov/imap/rest/services/Demographics/MD_AmericanCommunitySurvey/FeatureServer/0", "geometry": "polygon", "category": "demographics", "coreRenderable": true, "solutions": ["banking"] },
      { "id": "md-census-tracts", "title": "Census Statistical Boundaries (tracts)", "format": "arcgis-feature", "url": "https://mdgeodata.md.gov/imap/rest/services/Boundaries/MD_CensusStatisticalBoundaries/FeatureServer/0", "geometry": "polygon", "category": "boundaries", "coreRenderable": true, "solutions": ["banking"] },
      { "id": "md-local-business", "title": "Local Businesses", "format": "arcgis-feature", "url": "https://mdgeodata.md.gov/imap/rest/services/BusinessEconomy/MD_LocalBusinesses/FeatureServer/0", "geometry": "point", "category": "banking", "coreRenderable": true, "solutions": ["banking"] },

      { "id": "nws-alerts-md", "title": "NWS active weather alerts (MD)", "format": "json", "url": "https://api.weather.gov/alerts/active?area=MD", "geometry": "polygon", "category": "weather", "live": true, "refreshSeconds": 300, "coreRenderable": false, "access": { "cors": true, "requiresKey": false, "notes": "GeoJSON via api.weather.gov; load as geojson layer" }, "solutions": ["emergency-response"] },
      { "id": "nws-river-gauges", "title": "NWS river gauges (flood category)", "format": "mapserver", "url": "https://mapservices.weather.noaa.gov/eventdriven/rest/services/water/riv_gauges/MapServer/0", "geometry": "point", "category": "weather", "live": true, "refreshSeconds": 900, "coreRenderable": true, "access": { "cors": true }, "solutions": ["emergency-response"] },
      { "id": "usgs-quakes", "title": "USGS earthquakes (past week)", "format": "geojson", "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_week.geojson", "geometry": "point", "category": "hazard", "live": true, "refreshSeconds": 300, "coreRenderable": true, "access": { "cors": true }, "solutions": ["emergency-response", "banking"] },
      { "id": "fema-nfhl-flood", "title": "FEMA NFHL flood hazard zones", "format": "mapserver", "url": "https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer/28", "geometry": "polygon", "category": "hazard", "live": false, "coreRenderable": true, "access": { "cors": false, "requiresKey": false, "notes": "Non-CORS + slow — read via dev-proxy or server-side" }, "solutions": ["emergency-response", "banking"] },
      { "id": "fdic-branches-md", "title": "FDIC bank branches (MD)", "format": "json", "url": "https://banks.data.fdic.gov/api/locations?filters=STALP:MD&limit=2000", "geometry": "point", "category": "banking", "live": false, "coreRenderable": false, "access": { "cors": true, "notes": "JSON API — map lat/lon to points" }, "solutions": ["banking"] },

      { "id": "usgs-3dep-cog", "title": "USGS 3DEP elevation (COG)", "format": "cog", "url": "https://elevation.nationalmap.gov/arcgis/rest/services/3DEPElevation/ImageServer", "geometry": "raster", "category": "elevation", "coreRenderable": true, "access": { "cors": true, "notes": "Dynamic ImageServer; staged COGs at prd-tnm.s3.amazonaws.com" }, "solutions": ["showcase", "emergency-response"] },
      { "id": "overture-buildings-md", "title": "Overture buildings (GeoParquet)", "format": "geoparquet", "url": "s3://overturemaps-us-west-2/release/latest/theme=buildings/", "geometry": "polygon", "category": "base", "coreRenderable": false, "access": { "cors": false, "notes": "Forward ref — query via DuckDB/overturemaps CLI, bbox-clip to MD, or publish to Strata Serve" }, "solutions": ["showcase"] },
      { "id": "ms-buildings-md", "title": "Microsoft US Building Footprints — Maryland", "format": "geoparquet", "url": "https://minedbuildings.z5.web.core.windows.net/legacy/usbuildings-v2/Maryland.geojson.zip", "geometry": "polygon", "category": "base", "coreRenderable": false, "access": { "cors": false, "notes": "Forward ref — convert to GeoParquet/FlatGeobuf and tile" }, "solutions": ["showcase"] },
      { "id": "pmtiles-basemap", "title": "OSM basemap (PMTiles, offline/edge)", "format": "pmtiles", "url": "", "geometry": "vector-tile", "category": "base", "coreRenderable": false, "access": { "notes": "Forward ref — a PMTiles archive for offline/edge deployments; not yet a core LayerSourceKind" }, "solutions": ["emergency-response"] }
    ],

    "apps": {
      "showcase": {
        "defaultLayers": ["md-counties", "md-hospitals", "md-fire-stations"],
        "notes": "Boots with counties + facilities; the browse component adds more from servers[] / catalog[]."
      },
      "emergency-response": {
        "hazardLayers": ["md-floodplain", "fema-nfhl-flood", "nws-alerts-md", "usgs-quakes", "nws-river-gauges"],
        "facilityLayers": ["md-hospitals", "md-fire-stations", "md-ems", "md-police", "md-psap", "md-schools"],
        "populationLayer": "md-acs",
        "refreshSeconds": 300
      },
      "banking": {
        "collateralHazards": ["md-floodplain", "fema-nfhl-flood"],
        "demographicsLayer": "md-acs",
        "boundaryLayer": "md-census-tracts",
        "branchesSource": "fdic-branches-md"
      }
    }
