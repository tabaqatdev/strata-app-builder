      { "id": "md-mde", "title": "MD Dept. of the Environment (MDE)", "kind": "arcgis-server", "url": "https://mdewin64.mde.state.md.us/arcgis/rest/services/", "cors": false, "auth": { "type": "none" }, "tags": ["environment", "dam-safety"], "solutions": ["emergency-response"] },
      { "id": "baltimore-city", "title": "Baltimore City Enterprise GIS", "kind": "arcgis-server", "url": "https://gis.baltimorecity.gov/egis/rest/services/", "cors": true, "auth": { "type": "none" }, "tags": ["municipal"], "solutions": ["showcase"] },
      { "id": "montgomery-county", "title": "Montgomery County GIS", "kind": "arcgis-server", "url": "https://gis2.montgomerycountymd.gov/arcgis/rest/services/", "cors": true, "auth": { "type": "none" }, "tags": ["county"], "solutions": ["showcase"] },
      { "id": "census-tigerweb", "title": "US Census TIGERweb (tracts/counties/ZCTAs)", "kind": "arcgis-server", "url": "https://tigerweb.geo.census.gov/arcgis/rest/services/", "cors": true, "auth": { "type": "none" }, "tags": ["national", "demographics"], "solutions": ["banking"] },
      { "id": "fema-nfhl", "title": "FEMA National Flood Hazard Layer", "kind": "arcgis-server", "url": "https://hazards.fema.gov/arcgis/rest/services/", "cors": false, "auth": { "type": "none" }, "tags": ["national", "flood", "proxy-required"], "solutions": ["emergency-response", "banking"] },
      { "id": "nifc-wfigs", "title": "NIFC / WFIGS wildfire (national, hosted)", "kind": "arcgis-hosted", "url": "https://services3.arcgis.com/T4QMspbfLg3qTGWY/arcgis/rest/services/", "cors": true, "auth": { "type": "none" }, "tags": ["national", "wildfire"], "solutions": ["emergency-response"] }
    ],

