  "strata:notes": {
    "title": "District of Columbia — recipe test map",
    "summary": "A deliberately complete DC dataset for exercising the strata-app-builder recipes (except mapviewer). It spans every geometry type, standalone + related tables, a time-enabled layer, and rich categorical/numeric fields. All sources are public DC GIS (OCTO) FeatureServer/MapServer endpoints, CORS-enabled, and reprojected to EPSG:4326 by the arcgis-feature source (outSR=4326).",
    "theme": "DC places, property, demographics & public safety",
    "howToUse": "Copy this file into an app as layers.json (or /create-map), then run any recipe under recipes/. Each layer below is tagged with the recipes it best exercises. Recipe wizards pick fields; the tags say which layer to point them at.",
    "relationships": [
      {
        "originLayer": "dc-parcels",
        "relatedTable": "dc-property-assessment",
        "relationshipId": 11,
        "keyField": "SSL",
        "cardinality": "one-to-many",
        "purpose": "Click a parcel -> its tax/assessment record. For related-records recipes (manager) and queryRelatedRecords."
      },
      {
        "originLayer": "dc-crashes",
        "relatedTable": "dc-crash-details",
        "relationshipId": 3,
        "keyField": "CRIMEID",
        "cardinality": "one-to-many",
        "purpose": "Click a crash -> the people/details involved. Second related pair for related-records testing."
      }
    ],
    "timeField": {
      "layer": "dc-crashes",
      "field": "REPORTDATE",
      "note": "ArcGIS Date field (epoch-millis in queries). Layer is pre-filtered to Q4 2024; the time slider filters within that window."
    },
    "capabilityGaps": {
      "attachments": "NOT AVAILABLE. 118 DC + Maryland-iMap services were scanned for hasAttachments:true and none exist — attachments live in hosted Survey123/Field Maps layers, not authoritative open-data FeatureServers. The attachment-viewer recipe (and the media side of manager/reporter) needs a dedicated demo/ESRI layer.",
      "editing": "NOT AVAILABLE. These are read-only DC services. manager/web-editor/reporter need a writable + authenticated ESRI FeatureServer (see @strata/auth-arcgis). Reads (query/stats/related) work here; writes do not."
    },
    "layers": {
      "dc-wards": {
        "role": "demographic choropleth base",
        "geometry": "polygon (8 wards)",
        "categorical": [
          "NAMELSAD"
        ],
        "numeric": [
          "DP03_0062E (median household income)",
          "DP03_0088E (per-capita income)",
          "DP03_0009P (unemployment %)",
          "DP03_0119P (families below poverty %)"
        ],
        "recipes": [
          "interactive-legend",
          "chart-viewer",
          "compare",
          "observer",
          "countdown",
          "gallery",
          "category-gallery",
          "exhibit",
          "zone-lookup",
          "insets",
          "portfolio",
          "data-explorer",
          "sidebar",
          "basic",
          "vector-analysis"
        ]
      },
      "dc-zip-codes": {
        "role": "boundary/zone context (off by default)",
        "geometry": "polygon",
        "recipes": [
          "zone-lookup",
          "sidebar",
          "basic"
        ]
      },
      "dc-parcels": {
        "role": "feature side of a related pair",
        "geometry": "polygon (downtown, filtered)",
        "categorical": [
          "PROPTYPE"
        ],
        "relatedTable": "dc-property-assessment",
        "recipes": [
          "manager (related records)",
          "sidebar",
          "zone-lookup"
        ]
      },
      "dc-property-assessment": {
        "role": "table related to dc-parcels via SSL",
        "geometry": "table",
        "recipes": [
          "manager",
          "sidebar (attribute table)"
        ]
      },
      "dc-bike-routes": {
        "role": "line geometry",
        "geometry": "polyline",
        "categorical": [
          "WARD",
          "STREETTYPE"
        ],
        "numeric": [
          "LENGTH_MI"
        ],
        "recipes": [
          "basic",
          "sidebar",
          "vector-analysis (line input)"
        ]
      },
      "dc-crashes": {
        "role": "time-enabled dense point layer + feature side of a related pair",
        "geometry": "point (~4,930, Q4 2024)",
        "time": "REPORTDATE",
        "categorical": [
          "WARD"
        ],
        "numeric": [
          "TOTAL_VEHICLES",
          "TOTAL_PEDESTRIANS",
          "TOTAL_BICYCLES"
        ],
        "relatedTable": "dc-crash-details",
        "recipes": [
          "slider",
          "nearby",
          "public-notification",
          "observer",
          "reporter (clustering shape)",
          "chart-viewer (temporal)"
        ]
      },
      "dc-crash-details": {
        "role": "table related to dc-crashes via CRIMEID",
        "geometry": "table",
        "recipes": [
          "manager",
          "data-explorer"
        ]
      },
      "dc-affordable-housing": {
        "role": "point layer with numeric size field",
        "geometry": "point",
        "categorical": [
          "MAR_WARD",
          "STATUS_PUBLIC",
          "AGENCY_CALCULATED"
        ],
        "numeric": [
          "TOTAL_AFFORDABLE_UNITS"
        ],
        "recipes": [
          "nearby",
          "public-notification",
          "chart-viewer",
          "countdown",
          "gallery",
          "category-gallery",
          "basic"
        ]
      },
      "dc-address-table": {
        "role": "standalone (non-spatial) table",
        "geometry": "table",
        "recipes": [
          "sidebar (attribute table)"
        ]
      }
    }
  },
