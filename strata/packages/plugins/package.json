{
  "name": "@strata/plugins",
  "version": "0.3.0",
  "description": "The strata-app-builder plugin system: an ESRI Web Map-native plugin contract (modelled on GeoLibre's plugin API), app API, and a plugin manager.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
