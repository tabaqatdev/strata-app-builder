{
  "name": "@strata/state",
  "version": "0.3.0",
  "description": "Framework-agnostic Zustand store for strata-app-builder app state (layers, selection, view, basemap) with bounded undo/redo.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@strata/schema": "workspace:*",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
