{
  "name": "@strata/studio",
  "version": "0.1.0",
  "description": "A light visual editor for strata-app-builder AppLayouts: live preview + node selection + a property inspector + drag-to-reorder + theme picker, round-tripping the AppLayout JSON so mouse-edits, hand-edits, and Claude-edits all target the same file.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@strata/schema": "workspace:*",
    "@strata/theme": "workspace:*"
  },
  "peerDependencies": {
    "@strata/core-map": "workspace:*",
    "react": ">=18"
  },
  "devDependencies": {
    "@strata/core-map": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "react": "^18",
    "react-dom": "^18",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
