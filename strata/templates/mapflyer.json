{
  "version": "1.0",
  "//": "Strata template 'mapflyer' — a genuine <StrataApp> AppLayout. Demo data: WebMaps/md.json. See strata/templates/README.md.",
  "strata:template": {
    "id": "mapflyer",
    "name": "Mapflyer",
    "category": "grid",
    "webmap": "md",
    "tier": "simple",
    "blurb": "One map, many destinations: a grid of destination cards that fly the shared map around."
  },
  "theme": {
    "mode": "light",
    "colors": {
      "primary": "#1d4ed8",
      "secondary": "#f59e0b"
    }
  },
  "pages": [
    {
      "id": "main",
      "title": "Main",
      "type": "fixed",
      "root": {
        "kind": "splitter",
        "children": [
          {
            "kind": "section",
            "children": [
              {
                "kind": "widget",
                "widget": {
                  "type": "map",
                  "id": "map",
                  "props": {
                    "layerIds": [
                      "md-counties",
                      "md-hospitals",
                      "md-fire-stations"
                    ],
                    "controls": {
                      "navigation": true,
                      "scale": true,
                      "position": "top-right"
                    }
                  }
                }
              }
            ],
            "mode": "fixed",
            "style": {
              "flex": "1 1 0%",
              "minWidth": 0,
              "minHeight": 0,
              "height": "100%"
            }
          },
          {
            "kind": "grid",
            "children": [
              {
                "kind": "widget",
                "widget": {
                  "type": "button",
                  "id": "fly0",
                  "props": {
                    "label": "Fly to Baltimore",
                    "variant": "default"
                  }
                }
              },
              {
                "kind": "widget",
                "widget": {
                  "type": "button",
                  "id": "fly1",
                  "props": {
                    "label": "Fly to Annapolis",
                    "variant": "default"
                  }
                }
              },
              {
                "kind": "widget",
                "widget": {
                  "type": "button",
                  "id": "fly2",
                  "props": {
                    "label": "Fly to Frederick",
                    "variant": "default"
                  }
                }
              },
              {
                "kind": "widget",
                "widget": {
                  "type": "button",
                  "id": "fly3",
                  "props": {
                    "label": "Fly to Ocean City",
                    "variant": "default"
                  }
                }
              },
              {
                "kind": "widget",
                "widget": {
                  "type": "button",
                  "id": "fly4",
                  "props": {
                    "label": "Fly to Cumberland",
                    "variant": "default"
                  }
                }
              },
              {
                "kind": "widget",
                "widget": {
                  "type": "button",
                  "id": "flyHome",
                  "props": {
                    "label": "Statewide extent",
                    "variant": "primary"
                  }
                }
              }
            ],
            "columns": 2,
            "gap": 10,
            "style": {
              "padding": "12px",
              "overflow": "auto",
              "height": "100%"
            }
          }
        ],
        "sizes": [
          70,
          30
        ],
        "orientation": "h"
      },
      "header": {
        "kind": "row",
        "children": [
          {
            "kind": "widget",
            "widget": {
              "type": "text",
              "props": {
                "content": "Mapflyer",
                "as": "h3"
              }
            }
          },
          {
            "kind": "widget",
            "widget": {
              "type": "text",
              "props": {
                "content": "destination cards",
                "style": {
                  "opacity": "0.65",
                  "fontSize": "12px"
                }
              }
            }
          },
          {
            "kind": "widget",
            "widget": {
              "type": "text",
              "props": {
                "content": "",
                "style": {
                  "flex": "1"
                }
              }
            }
          },
          {
            "kind": "widget",
            "widget": {
              "type": "theme-switch",
              "id": "themeSwitch",
              "props": {
                "presets": [
                  "light",
                  "dark"
                ]
              }
            }
          },
          {
            "kind": "widget",
            "widget": {
              "type": "share"
            }
          }
        ],
        "gap": 12,
        "style": {
          "alignItems": "center",
          "padding": "10px 16px"
        }
      }
    }
  ],
  "connections": [
    {
      "from": "fly0",
      "trigger": "buttonClick",
      "to": "map",
      "action": "zoomTo",
      "options": {
        "viewpoint": {
          "center": [
            -76.61,
            39.29
          ],
          "zoom": 11
        }
      }
    },
    {
      "from": "fly1",
      "trigger": "buttonClick",
      "to": "map",
      "action": "zoomTo",
      "options": {
        "viewpoint": {
          "center": [
            -76.49,
            38.98
          ],
          "zoom": 12
        }
      }
    },
    {
      "from": "fly2",
      "trigger": "buttonClick",
      "to": "map",
      "action": "zoomTo",
      "options": {
        "viewpoint": {
          "center": [
            -77.41,
            39.41
          ],
          "zoom": 11
        }
      }
    },
    {
      "from": "fly3",
      "trigger": "buttonClick",
      "to": "map",
      "action": "zoomTo",
      "options": {
        "viewpoint": {
          "center": [
            -75.08,
            38.34
          ],
          "zoom": 11
        }
      }
    },
    {
      "from": "fly4",
      "trigger": "buttonClick",
      "to": "map",
      "action": "zoomTo",
      "options": {
        "viewpoint": {
          "center": [
            -78.76,
            39.65
          ],
          "zoom": 11
        }
      }
    },
    {
      "from": "flyHome",
      "trigger": "buttonClick",
      "to": "map",
      "action": "zoomTo",
      "options": {
        "viewpoint": {
          "center": [
            -77.2,
            39.0
          ],
          "zoom": 7
        }
      }
    }
  ]
}
