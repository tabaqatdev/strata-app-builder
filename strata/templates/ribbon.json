{
  "version": "1.0",
  "//": "Strata template 'ribbon' — a genuine <StrataApp> AppLayout. Demo data: WebMaps/md.json. See strata/templates/README.md.",
  "strata:template": {
    "id": "ribbon",
    "name": "Ribbon",
    "category": "web-page",
    "webmap": "md",
    "tier": "simple",
    "blurb": "A horizontal bookmark ribbon across the top; click a chip, the map flies there."
  },
  "theme": {
    "mode": "light",
    "colors": {
      "primary": "#4f46e5"
    }
  },
  "pages": [
    {
      "id": "main",
      "title": "Main",
      "type": "fixed",
      "root": {
        "kind": "column",
        "children": [
          {
            "kind": "row",
            "children": [
              {
                "kind": "widget",
                "widget": {
                  "type": "bookmarks",
                  "id": "ribbon",
                  "props": {
                    "title": "Places",
                    "bookmarks": [
                      {
                        "name": "Baltimore",
                        "viewpoint": {
                          "center": [
                            -76.61,
                            39.29
                          ],
                          "zoom": 11
                        }
                      },
                      {
                        "name": "Annapolis",
                        "viewpoint": {
                          "center": [
                            -76.49,
                            38.98
                          ],
                          "zoom": 12
                        }
                      },
                      {
                        "name": "Frederick",
                        "viewpoint": {
                          "center": [
                            -77.41,
                            39.41
                          ],
                          "zoom": 11
                        }
                      },
                      {
                        "name": "Ocean City",
                        "viewpoint": {
                          "center": [
                            -75.08,
                            38.34
                          ],
                          "zoom": 11
                        }
                      },
                      {
                        "name": "Cumberland",
                        "viewpoint": {
                          "center": [
                            -78.76,
                            39.65
                          ],
                          "zoom": 11
                        }
                      }
                    ]
                  }
                }
              }
            ],
            "style": {
              "flex": "0 0 auto",
              "padding": "8px 12px",
              "borderBottom": "1px solid var(--strata-border)",
              "overflowX": "auto"
            }
          },
          {
            "kind": "section",
            "children": [
              {
                "kind": "widget",
                "widget": {
                  "type": "map",
                  "id": "map",
                  "props": {
                    "layerIds": [
                      "md-counties",
                      "md-hospitals",
                      "md-fire-stations"
                    ],
                    "controls": {
                      "navigation": true,
                      "scale": true,
                      "position": "top-right"
                    }
                  }
                }
              }
            ],
            "mode": "fixed",
            "style": {
              "flex": "1 1 0%",
              "minHeight": 0
            }
          }
        ],
        "style": {
          "height": "100%"
        }
      },
      "header": {
        "kind": "row",
        "children": [
          {
            "kind": "widget",
            "widget": {
              "type": "text",
              "props": {
                "content": "Ribbon",
                "as": "h3"
              }
            }
          },
          {
            "kind": "widget",
            "widget": {
              "type": "text",
              "props": {
                "content": "bookmark strip",
                "style": {
                  "opacity": "0.65",
                  "fontSize": "12px"
                }
              }
            }
          },
          {
            "kind": "widget",
            "widget": {
              "type": "text",
              "props": {
                "content": "",
                "style": {
                  "flex": "1"
                }
              }
            }
          },
          {
            "kind": "widget",
            "widget": {
              "type": "theme-switch",
              "id": "themeSwitch",
              "props": {
                "presets": [
                  "light",
                  "dark"
                ]
              }
            }
          },
          {
            "kind": "widget",
            "widget": {
              "type": "share"
            }
          }
        ],
        "gap": 12,
        "style": {
          "alignItems": "center",
          "padding": "10px 16px"
        }
      }
    }
  ],
  "connections": [
    {
      "from": "map",
      "trigger": "featureSelect",
      "to": "map",
      "action": "flash"
    },
    {
      "from": "map",
      "trigger": "featureSelect",
      "to": "map",
      "action": "zoomTo"
    }
  ]
}
