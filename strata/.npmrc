# The Esri libraries behind @strata/feature-arcgis are OPTIONAL peer deps, loaded lazily at runtime
# (see packages/feature-arcgis/src/index.ts). They are not published for public install, so pnpm must
# not try to auto-install them — otherwise a fresh `pnpm install` 404s on @esri/arcgis-feature-service.
auto-install-peers=false
strict-peer-dependencies=false
